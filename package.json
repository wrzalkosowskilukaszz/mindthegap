{
  "name": "mindthegap-outreach-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "research:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-research.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/worker/cli.ts",
    "hash-password": "node --import tsx scripts/hash-password.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@fontsource-variable/inter": "^5.3.0",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.4",
    "jszip": "3.10.2",
    "lucide-react": "1.57.0",
    "luxon": "3.7.2",
    "mammoth": "1.13.0",
    "next": "16.4.1",
    "nodemailer": "10.1.1",
    "papaparse": "5.7.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "robots-parser": "3.0.1",
    "server-only": "0.0.1",
    "undici": "^8.12.1",
    "unpdf": "1.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
