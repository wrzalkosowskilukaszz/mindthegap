# Mind The Gap — Outreach Studio. Copy to .env.local (never commit it) and fill in.
# Required values are marked REQUIRED. Everything else is optional: the app shows
# "awaiting configuration" for an integration until its key is set.

# --- Core (REQUIRED) -------------------------------------------------------------
# Postgres connection string. Locally: postgres://mtg:mtg@localhost:5432/mtg_dev
# On Neon: use the pooled connection string (host contains "-pooler") with sslmode=require.
DATABASE_URL=
# Public URL of the app (used for OAuth redirects and links). No trailing slash.
APP_URL=http://localhost:3000
# Login password hash. Generate with:  pnpm hash-password
APP_PASSWORD_HASH=
# Random secrets, at least 32 characters each. Generate with:  openssl rand -base64 48
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
# Shared secret for the scheduler (Vercel Cron sends it automatically as a Bearer token). Min 12 chars.
CRON_SECRET=

# --- Integration tests only -----------------------------------------------------------
# A disposable database: the integration tests wipe it. Leave empty to skip them.
TEST_DATABASE_URL=

# --- AI (email drafting, material summaries, assisted extraction) --------------------
ANTHROPIC_API_KEY=
# Model ids. Both default to claude-opus-5-5.
AI_MODEL=
AI_MODEL_FAST=

# --- Contact data provider (paid; budgets in Kontakty → Odkrywanie) -----------------
HUNTER_API_KEY=

# --- Web search for finding new companies (optional; free tier available) ----------
TAVILY_API_KEY=

# --- Gmail (optional; without it you copy the email and mark it as sent by hand) ----
# Google Cloud OAuth client of type "Web application".
# Authorised redirect URI:  $APP_URL/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Real sending stays off until this is exactly "true".
SENDING_ENABLED=false

# --- Tuning (optional) ----------------------------------------------------------------
# Page the crawler names in its User-Agent so site owners can see who is visiting.
CRAWLER_CONTACT_URL=https://leadersmindthegap.com/
# Seconds of work per scheduler tick (default 270; keep below the host's function limit).
TICK_BUDGET_SECONDS=
# Database connections per process (default 5; use 1–3 on serverless hosts).
DB_POOL_MAX=
